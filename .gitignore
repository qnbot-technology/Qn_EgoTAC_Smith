dist/

# Never publish checkpoints outside weights either.
*.pt
*.pth
*.ckpt
*.pkl
*.safetensors

# HumanV2 is a binary distribution. Never add private implementation material.
third_party/humanv2/**
!third_party/humanv2/README.md
!third_party/humanv2/LICENSE.txt
!third_party/humanv2/common.py
!third_party/humanv2/requirements.txt
!third_party/humanv2/runtime-manifest.json
!third_party/humanv2/runtime/
!third_party/humanv2/runtime/**
!third_party/humanv2/native/
!third_party/humanv2/native/qnbot_hand/
